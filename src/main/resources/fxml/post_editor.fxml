<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.amalitech.ui.controller.PostEditorController" prefHeight="500.0" prefWidth="600.0">
    <VBox alignment="TOP_CENTER" spacing="20.0" styleClass="content-card">
        <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Title:" styleClass="form-label" />
            <TextField fx:id="titleField" styleClass="text-field" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Body:" styleClass="form-label" />
            <TextArea fx:id="bodyField" prefRowCount="10" styleClass="text-area" HBox.hgrow="ALWAYS" VBox.vgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label text="Tags:" styleClass="form-label" />
            <ListView fx:id="tagsList" prefHeight="100.0" styleClass="modern-list" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox alignment="CENTER" spacing="10.0">
            <Button text="Save" onAction="#onSave" styleClass="primary-button" />
            <Button text="Cancel" onAction="#onCancel" styleClass="secondary-button" />
        </HBox>
    </VBox>
</StackPane>