<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Feed View: Content-First, Infinite Scroll -->
<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.amalitech.ui.controller.FeedViewController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="feed-scroll">

    <VBox spacing="0" styleClass="feed-container">
        <padding>
            <Insets top="32" right="48" bottom="32" left="48"/>
        </padding>

        <!-- Feed Header with Filters -->
        <VBox spacing="16" styleClass="feed-header">
            <padding>
                <Insets bottom="24"/>
            </padding>

            <!-- Title -->
            <Label fx:id="feedTitle" text="Latest Posts" styleClass="heading-1"/>

            <!-- Filters: Smart & Minimal -->
            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="sortFilter"
                          promptText="Latest"
                          prefWidth="140"
                          styleClass="combo-box"/>

                <ComboBox fx:id="timeFilter"
                          promptText="All time"
                          prefWidth="140"
                          styleClass="combo-box"/>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Reading time filter (subtle) -->
                <Label text="Reading time:" styleClass="caption"/>
                <Button text="Any" onAction="#onFilterAny" styleClass="ghost-button"/>
                <Button text="5 min" onAction="#onFilterShort" styleClass="ghost-button"/>
                <Button text="5-10 min" onAction="#onFilterMedium" styleClass="ghost-button"/>
            </HBox>
        </VBox>

        <!-- Post Feed: Card-based, Clean -->
        <VBox fx:id="postFeed" spacing="20" styleClass="post-feed">
            <!-- Posts will be dynamically loaded here -->
            <!-- Each post card follows this structure:
                 [Post Card]
                   - Title (large, bold)
                   - Excerpt (2-3 lines)
                   - Author • Date • Read time
                   - Tags (chips)
                   - Engagement (likes, comments)
            -->
        </VBox>

        <!-- Loading Indicator -->
        <VBox fx:id="loadingIndicator"
              alignment="CENTER"
              spacing="16"
              managed="false"
              visible="false">
            <padding>
                <Insets top="32" bottom="32"/>
            </padding>
            <Label text="Loading more posts..." styleClass="caption"/>
        </VBox>

        <!-- End of Feed Message -->
        <VBox fx:id="endOfFeed"
              alignment="CENTER"
              spacing="16"
              managed="false"
              visible="false">
            <padding>
                <Insets top="48" bottom="48"/>
            </padding>
            <Label text="You've reached the end!" styleClass="heading-3"/>
            <Label text="Check back later for more content" styleClass="caption"/>
        </VBox>

    </VBox>

</ScrollPane>
