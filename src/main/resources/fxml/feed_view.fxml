<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.amalitech.ui.controller.FeedViewController"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="feed-scroll">

    <VBox styleClass="feed-container">
        <padding>
            <Insets top="32" right="48" bottom="32" left="48"/>
        </padding>

        <VBox spacing="16" styleClass="feed-header">
            <padding>
                <Insets bottom="24"/>
            </padding>
            <Label fx:id="feedTitle" text="Latest Posts" styleClass="heading-1"/>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <ComboBox fx:id="sortFilter"
                          promptText="Latest"
                          prefWidth="140"
                          styleClass="combo-box"/>

                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </VBox>

        <VBox fx:id="postFeed" spacing="20" styleClass="post-feed">

        </VBox>

        <VBox fx:id="loadingIndicator"
              alignment="CENTER"
              spacing="16"
              managed="false"
              visible="false">
            <padding>
                <Insets top="32" bottom="32"/>
            </padding>
            <Label text="Loading more posts..." styleClass="caption"/>
        </VBox>
        <VBox fx:id="endOfFeed"
              alignment="CENTER"
              spacing="16"
              managed="false"
              visible="false">
            <padding>
                <Insets top="48" bottom="48"/>
            </padding>
            <Label text="Check back later for more content" styleClass="caption"/>
        </VBox>

        <VBox spacing="16" alignment="CENTER">
            <HBox spacing="12" alignment="CENTER">
                <Button text="Previous" onAction="#onPreviousPage" disable="true" fx:id="prevButton"/>
                <Button text="Next" onAction="#onNextPage" fx:id="nextButton"/>
            </HBox>
        </VBox>
    </VBox>
</ScrollPane>
