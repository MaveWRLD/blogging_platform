<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.amalitech.ui.controller.MainLayoutController"
            styleClass="root">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" styleClass="app-bar">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <Label text="BlogSpace" styleClass="app-title"/>

            <TextField fx:id="searchField"
                       promptText="Search posts, tags, authors... (Ctrl+K)"
                       prefWidth="400"
                       onAction="#onSearch"
                       styleClass="text-field"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Button text="Write"
                    onAction="#onWrite"
                    styleClass="primary-button"/>

            <Button fx:id="performanceButton"
                    text="Performance Metrics"
                    onAction="#onPerformanceMetrics" />
        </HBox>
    </top>

    <center>
        <HBox styleClass="main-container">

            <VBox spacing="24" styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240">
                <padding>
                    <Insets top="24" right="16" bottom="24" left="24"/>
                </padding>

                <VBox spacing="8">
                    <Label text="FEED" styleClass="sidebar-section-title"/>
                    <Button text="Home"
                            onAction="#onHome"
                            styleClass="sidebar-button"
                            maxWidth="Infinity"/>
                </VBox>

                <VBox spacing="8" fx:id="tagsContainer">
                    <Label text="TAGS" styleClass="sidebar-section-title"/>
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                styleClass="transparent-scroll"
                                maxHeight="300">
                        <VBox fx:id="tagsList" spacing="6"/>
                    </ScrollPane>
                </VBox>

                <Region VBox.vgrow="ALWAYS"/>

                <VBox spacing="8">
                    <Button text="🚪 Logout"
                            onAction="#onLogout"
                            styleClass="sidebar-button-subtle"
                            maxWidth="Infinity"/>
                </VBox>
            </VBox>

            <StackPane fx:id="contentArea" HBox.hgrow="ALWAYS" styleClass="content-area">
                <fx:include source="/fxml/feed_view.fxml"/>
            </StackPane>

        </HBox>
    </center>

</BorderPane>
