<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.amalitech.ui.controller.CommentsController" styleClass="root">
    <center>
        <VBox spacing="10.0" styleClass="content-card" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <ListView fx:id="commentsList" styleClass="modern-list" VBox.vgrow="ALWAYS" />
        </VBox>
    </center>
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="input-bar">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <TextArea fx:id="commentField" prefRowCount="3" styleClass="text-area" HBox.hgrow="ALWAYS" />
            <VBox spacing="10.0">
                <Button text="Add" onAction="#onAdd" styleClass="primary-button" />
                <Button text="Delete Selected" onAction="#onDelete" styleClass="secondary-button" />
            </VBox>
        </HBox>
    </bottom>
</BorderPane>