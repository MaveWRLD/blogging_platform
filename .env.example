# Copy this file to .env and adjust values as needed.
# With `docker compose up`, Postgres/MongoDB connection details below are
# only used to configure the containers themselves - the app always reaches
# them via the in-network hostnames set in docker-compose.yml.

# --- Postgres ---
POSTGRES_DB=blogdb
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# --- MongoDB ---
MONGODB_DATABASE=blog_comments

# --- JWT ---
# Any long random string works for local dev.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRATION=3600000

# --- Google OAuth2 login ---
# Must be non-empty for the app to start (Spring validates registered OAuth2
# clients at boot). Leave the dummy values below if you don't need Google
# login locally; set real values from the Google Cloud Console to enable it.
GOOGLE_CLIENT_ID=dummy-client-id
GOOGLE_CLIENT_SECRET=dummy-client-secret

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
